@startuml c4-context
!include <C4/C4_Context>

title System Context - Mars Rover

Person(operator, "Mission Operator", "Defines the map, the rover start position and the command sequence")
System(rover, "Mars Rover Simulator", "Executes movement commands on a map with obstacles and reports the final position and heading")
System_Ext(mission, "Mission File", "Map with obstacles, start position (x, y, heading) and commands")

Rel(operator, mission, "Writes")
Rel(operator, rover, "Submits missions and reads results", "HTTPS / CLI")
Rel(rover, mission, "Reads")
@enduml
